# Copy to .env.local for dev, or set as real env vars on the droplet
DATABASE_URL=postgresql://user:password@localhost:5432/the_record

# Powers "Ask the Record" chatbot — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx

# Powers ingestion/extract_from_video.py (video watching/claim extraction)
GEMINI_API_KEY=xxxx

# Powers ingestion/identify_speaker.py (voice enrollment/matching).
# Optional for now — the system falls back to context-only speaker
# identification when this isn't set. Add once available.
# PYANNOTE_API_KEY=xxxx

NEXT_PUBLIC_SITE_URL=https://sknlphub.tekii.org
